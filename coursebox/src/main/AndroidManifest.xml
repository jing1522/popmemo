<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SAF 选目录不需要权限；分享进来的 content:// 由系统临时授权 -->

    <application
        android:label="课匣"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".CourseActivity" android:exported="false" />

        <!-- 点击文件时给系统 App 临时读权限（预览私有目录里的文件） -->
        <provider
            android:name=".FileServer"
            android:authorities="com.coursebox.files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity android:name=".ImportActivity" android:exported="false" />
        <activity android:name=".BrowseActivity" android:exported="false" />

        <!-- 系统分享菜单入口：任意文件/图片都能分享进来 -->
        <activity
            android:name=".CaptureActivity"
            android:exported="true"
            android:theme="@style/DialogTheme"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
